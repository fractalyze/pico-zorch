load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@pico_zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# The polynomial commitment scheme: domains, extension and committed order.
# Binding the extended matrices to a root belongs to //pico_zorch/commit:mmcs.
py_library(
    name = "two_adic_fri",
    srcs = [
        "__init__.py",
        "open.py",
        "two_adic_fri.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pico_zorch",
        "//pico_zorch/commit:mmcs",
        "//pico_zorch/challenger",
        "//pico_zorch/uni_stark:fri",
        "@zorch//zorch/coding:reed_solomon",
        "@zorch//zorch/poly",
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "two_adic_fri_test",
    srcs = ["two_adic_fri_test.py"],
    data = ["//pico_zorch/commit:testdata/golden/batch_commit.json"],
    deps = [
        ":two_adic_fri",
        "//pico_zorch/challenger",
        "//pico_zorch/commit:mmcs",
        "//pico_zorch/poseidon2:koalabear",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "open_test",
    srcs = ["open_test.py"],
    data = ["testdata/golden/pcs_open.json"],
    deps = [
        ":two_adic_fri",
        "//pico_zorch/challenger",
        "//pico_zorch/commit:mmcs",
        "//pico_zorch/poseidon2:koalabear",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
