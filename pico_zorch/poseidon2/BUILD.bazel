load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@pico_zorch_pip//:requirements.bzl", "requirement")

# Pico's Poseidon2-KoalaBear-16 instance + Plonky3 MerkleTreeMmcs-shaped stack.
py_library(
    name = "koalabear",
    srcs = [
        "__init__.py",
        "koalabear.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pico_zorch",
        "@zorch//zorch/commit:merkle",
        "@zorch//zorch/hash:compression",
        "@zorch//zorch/hash:sponge",
        "@zorch//zorch/hash/poseidon2",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "koalabear_test",
    srcs = ["koalabear_test.py"],
    deps = [
        ":koalabear",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)
