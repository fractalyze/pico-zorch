load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@pico_zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# TwoAdicFriPcs.commit: shift-3 coset LDE, bit-reversed rows, one Merkle tree.
py_library(
    name = "pcs_commit",
    srcs = [
        "__init__.py",
        "pcs_commit.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pico_zorch",
        "@zorch//zorch/coding:reed_solomon",
        "@zorch//zorch/commit:merkle",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "pcs_commit_test",
    srcs = ["pcs_commit_test.py"],
    data = ["testdata/golden/trace_commit.json"],
    deps = [
        ":pcs_commit",
        "//pico_zorch/poseidon2:koalabear",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
