load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@pico_zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# The Merkle commitment scheme, one layer below the PCS: it binds a batch of
# already-extended matrices to a root and knows nothing about domains or FRI.
py_library(
    name = "mmcs",
    srcs = [
        "__init__.py",
        "mmcs.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pico_zorch",
        "@zorch//zorch/commit:merkle",
        requirement("frx"),
    ],
)

py_test(
    name = "mmcs_test",
    srcs = ["mmcs_test.py"],
    data = ["testdata/golden/batch_commit.json"],
    deps = [
        ":mmcs",
        "//pico_zorch/poseidon2:koalabear",
        "//pico_zorch/uni_stark:fri",
        "@zorch//zorch/coding:reed_solomon",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
