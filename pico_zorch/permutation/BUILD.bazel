load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@pico_zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# LogUp: the per-chip permutation trace and its regional cumulative sum.
py_library(
    name = "logup",
    srcs = [
        "__init__.py",
        "logup.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pico_zorch",
        "@zorch//zorch/poly",
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "logup_test",
    srcs = ["logup_test.py"],
    data = ["testdata/golden/logup.json"],
    deps = [
        ":logup",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
