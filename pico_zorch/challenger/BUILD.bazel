load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@pico_zorch_pip//:requirements.bzl", "requirement")

# Pico's DuplexChallenger as a zorch DuplexTranscript flavour.
py_library(
    name = "challenger",
    srcs = [
        "__init__.py",
        "challenger.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pico_zorch",
        "//pico_zorch/poseidon2:koalabear",
        "@zorch//zorch:transcript",
        "@zorch//zorch/hash/poseidon2",
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "challenger_test",
    srcs = ["challenger_test.py"],
    data = ["testdata/golden/challenger.json"],
    deps = [
        ":challenger",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)
