load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@pico_zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_library(
    name = "air",
    srcs = [
        "__init__.py",
        "air.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pico_zorch",
        requirement("frx"),
    ],
)

py_library(
    name = "domain",
    srcs = ["domain.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":air",
        "@zorch//zorch/coding:reed_solomon",
        "@zorch//zorch/poly",
        requirement("frx"),
    ],
)

py_library(
    name = "quotient",
    srcs = ["quotient.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":air",
        ":domain",
        "@zorch//zorch/pcs:fold",
        "@zorch//zorch/poly",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_library(
    name = "types",
    srcs = ["types.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":air",
        "@zorch//zorch/commit:merkle",
        requirement("frx"),
    ],
)

py_library(
    name = "prover",
    srcs = [
        "fri_stage.py",
        "prover.py",
        "quotient_stage.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":air",
        ":domain",
        ":quotient",
        ":types",
        "//pico_zorch/challenger",
        "//pico_zorch/commit:pcs_commit",
        "@zorch//zorch:stage",
        "@zorch//zorch:transcript",
        "@zorch//zorch/coding:reed_solomon",
        "@zorch//zorch/commit:merkle",
        "@zorch//zorch/pcs:fold",
        "@zorch//zorch/poly",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_library(
    name = "verifier",
    srcs = ["verifier.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":air",
        ":domain",
        ":prover",
        ":types",
        "//pico_zorch/challenger",
        "//pico_zorch/commit:pcs_commit",
        "@zorch//zorch:stage",
        "@zorch//zorch:transcript",
        "@zorch//zorch/coding:reed_solomon",
        "@zorch//zorch/commit:merkle",
        "@zorch//zorch/poly",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "verifier_test",
    size = "large",
    srcs = ["verifier_test.py"],
    deps = [
        ":fib_air",
        ":prover",
        ":types",
        ":verifier",
        "//pico_zorch/challenger",
        "//pico_zorch/poseidon2:koalabear",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_binary(
    name = "bench_prove",
    srcs = ["bench_prove.py"],
    data = ["testdata/golden/fib_prove.json"],
    deps = [
        ":fib_air",
        ":prover",
        ":types",
        "//pico_zorch/challenger",
        "//pico_zorch/commit:pcs_commit",
        "//pico_zorch/poseidon2:koalabear",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_binary(
    name = "profile_fri_open",
    srcs = ["profile_fri_open.py"],
    deps = [
        ":bench_lib",
    ] + GPU_PLUGIN_DEPS,
)

py_library(
    name = "bench_lib",
    srcs = ["bench_prove.py"],
    data = ["testdata/golden/fib_prove.json"],
    deps = [
        ":fib_air",
        ":prover",
        ":types",
        "//pico_zorch/challenger",
        "//pico_zorch/commit:pcs_commit",
        "//pico_zorch/poseidon2:koalabear",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_library(
    name = "fib_air",
    srcs = [
        "testing/__init__.py",
        "testing/fib_air.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "fib_e2e_test",
