# pico-zorch runtime dependencies.
#
# Pulled from the Fractalyze package index alongside upstream PyPI:
#   pip install -r requirements.in \
#     --extra-index-url https://fractalyze.github.io/pypi/simple/
absl-py
numpy
# frx = Field, Ring Accelerated. Pins track zorch's requirements.in
# at the MODULE.bazel git_override commit — they build against a shared frxlib,
# so a lagging pin ABI-mismatches and segfaults the GPU tests.
frx==0.10.2.dev20260818233737
frxlib==0.10.2.dev20260818233737
frx-cuda12-pjrt==0.10.2.dev20260818233737
# `[with-cuda]` pulls the CUDA 12 userspace (cublas, cudart, cudnn, nccl, ...)
# in as wheels. Without it the plugin .so resolves but finds no CUDA runtime,
# `cudaRuntimeGetVersion` fails, and frx falls back to CPU with only a warning
# — a GPU leg that silently measures the CPU backend. The wheels also keep the
# CUDA version pinned to the plugin rather than to whatever the host installed.
frx-cuda12-plugin[with-cuda]==0.10.2.dev20260818233737
zk-dtypes==0.0.10
hash-frx==0.2.0.dev20260819071642
